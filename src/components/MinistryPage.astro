---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import PageHero from "./PageHero.astro";
import { church, ministries } from "../data/site";

interface Props { slug: (typeof ministries)[number]["slug"]; }
const { slug } = Astro.props;
const ministry = ministries.find((item) => item.slug === slug);
if (!ministry) throw new Error(`Unknown ministry: ${slug}`);

const ministryImageNames: Partial<Record<Props["slug"], string>> = {
  sundaySchool: "sunday-school",
  youngadult: "young-adults",
};
const imageName = ministryImageNames[slug] ?? slug;
const imagePath = `/src/assets/ministries/${imageName}.jpeg`;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/ministries/*.{jpeg,jpg,png,webp}",
  { eager: true },
);
const ministryImage = images[imagePath]?.default;
---

<PageHero eyebrow="Auxiliary Ministry" title={ministry.name} intro={ministry.motto} />
{ministryImage && (
  <div class="container ministry-photo">
    <Image
      class="ministry-photo__image"
      src={ministryImage}
      alt={`Members serving in ${ministry.name}`}
      layout="constrained"
      width={1088}
      quality={82}
    />
  </div>
)}
<section class="section">
  <div class="container content-grid">
    <article class="prose">
      <p class="eyebrow">Our mission</p>
      <h2>Serving with purpose</h2>
      <p class="lead">{ministry.mission}</p>
    </article>
    <aside class="scripture-card" aria-label={`${ministry.name} scripture`}>
      <span class="scripture-card__mark" aria-hidden="true">“</span>
      <blockquote>{ministry.scripture}</blockquote>
      <cite>{ministry.scriptureReference}</cite>
    </aside>
  </div>
</section>
<section class="section section--tint">
  <div class="container callout-row">
    <div>
      <p class="eyebrow">Get connected</p>
      <h2>There is a place for you to serve.</h2>
      <p>Contact the church office to learn more about {ministry.name}.</p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href={`mailto:${church.email}`}>Email the church</a>
      <a class="button button--outline" href="/ministries">All ministries</a>
    </div>
  </div>
</section>

<style>
  .ministry-photo {
    position: relative;
    z-index: 2;
    max-width: 68rem;
    margin-top: clamp(-3rem, -4vw, -2rem);
  }

  .ministry-photo__image {
    width: 100%;
    height: auto;
    border: 5px solid white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 560px) {
    .ministry-photo {
      width: min(calc(100% - 1rem), 68rem);
      margin-top: -1.5rem;
    }

    .ministry-photo__image {
      border-width: 3px;
      border-radius: var(--radius-md);
    }
  }
</style>
