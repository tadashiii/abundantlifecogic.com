---
import { church } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/alcogic-icon.svg" alt="" width="64" height="64" />
      <div><strong>{church.name}</strong><p>{church.tagline}</p></div>
    </div>
    <div>
      <h2>Visit</h2>
      <address><a href={church.mapUrl} target="_blank" rel="noreferrer">{church.address}</a></address>
      <p>Sunday School at 9:00 AM<br />Worship at 10:00 AM</p>
    </div>
    <div>
      <h2>Connect</h2>
      <ul class="footer-links">
        <li><a href={`tel:${church.phoneHref}`}>{church.phoneDisplay}</a></li>
        <li><a href={`mailto:${church.email}`}>{church.email}</a></li>
        <li><a href="/contact">Contact us</a></li>
      </ul>
    </div>
    <div>
      <h2>Follow</h2>
      <ul class="footer-links">
        <li><a href={church.social.facebook} target="_blank" rel="noreferrer">Facebook</a></li>
        <li><a href={church.social.youtube} target="_blank" rel="noreferrer">YouTube</a></li>
        <li><a href={church.social.instagram} target="_blank" rel="noreferrer">Instagram</a></li>
        <li><a href={church.social.tiktok} target="_blank" rel="noreferrer">TikTok</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {church.shortName}. All rights reserved.</p>
    <div><a href="/announcements">Announcements</a><a href="/give">Give</a></div>
  </div>
</footer>
