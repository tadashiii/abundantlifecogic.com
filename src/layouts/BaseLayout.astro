---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
    }

const {
    title,
    description = "Abundant Life Church of God in Christ",
    } = Astro.props;
---

{/* Every page will uses this for consistency between navigation, footer, fonts,
and SEO are consistent. */}

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/alcogic-image.svg" />
        <title>{title} | Abundant Life Church of God in Christ</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>
