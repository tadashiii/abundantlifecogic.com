---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { church, ministries, ministryTheme, services } from "../data/site";
---

<BaseLayout title="Home" description="Welcome to Abundant Life Church of God in Christ in Sacramento. Join us for worship, prayer, Bible study, and community.">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Welcome home</p>
        <h1>A place to worship, grow, and serve.</h1>
        <p class="hero-lead">{church.tagline} Join the Abundant Life church family in Sacramento as we seek God, grow in faith, and serve our community together.</p>
        <div class="button-row">
          <Button href="/visit">Plan your visit</Button>
          <Button href="/livestream" variant="outline">Watch online</Button>
        </div>
      </div>

      <aside class="service-panel" aria-label="Sunday service times">
        <div class="service-panel__top">
          <img src="/alcogic-icon.svg" alt="" width="76" height="76" />
          <p><span>This Sunday</span><strong>Come worship with us</strong></p>
        </div>
        <div class="service-panel__times">
          <div><span>Sunday School</span><strong>9:00 AM</strong></div>
          <div><span>Worship Service</span><strong>10:00 AM</strong></div>
        </div>
        <a href={church.mapUrl} target="_blank" rel="noreferrer">{church.address} <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="quick-links" aria-label="Quick links">
    <div class="container quick-links__grid">
      <a href="/visit"><span>01</span><strong>New here?</strong><small>Everything you need for your first visit</small></a>
      <a href="/events"><span>02</span><strong>What’s happening</strong><small>Services, gatherings, and church events</small></a>
      <a href="/give"><span>03</span><strong>Give online</strong><small>Support the work of the ministry</small></a>
    </div>
  </section>

  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">You are welcome here</p>
        <h2>Come as you are. There is a place for you.</h2>
      </div>
      <div>
        <p class="lead">Whether you are visiting church for the first time, returning to faith, or looking for a church family, we invite you to experience worship and community at Abundant Life.</p>
        <a class="text-link" href="/about">Learn more about our church <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Weekly gatherings</p><h2>Grow with us throughout the week.</h2></div>
        <a href="/events">View church calendar</a>
      </div>
      <div class="schedule-grid">
        {services.map((service) => (
          <article><span>{service.day}</span><h3>{service.name}</h3><p>{service.time}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section ministries-preview">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">{ministryTheme.motto}</p><h2>{ministryTheme.title}</h2></div>
        <a href="/ministries">Explore all ministries</a>
      </div>
      <div class="cards">
        {ministries.slice(0, 3).map((ministry) => (
          <a class="card card-link" href={`/ministries/${ministry.slug}`}>
            <p class="card-number">0{ministries.indexOf(ministry) + 1}</p>
            <h3>{ministry.name}</h3>
            <p>{ministry.motto}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container callout-row">
      <div><p class="eyebrow">Stay connected</p><h2>Church news and upcoming events.</h2><p>Visit the announcements page for church updates or see the calendar for what’s next.</p></div>
      <div class="button-row"><Button href="/announcements">Announcements</Button><Button href="/events" variant="outline">View calendar</Button></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; overflow: hidden; padding-block: clamp(4.5rem, 10vw, 8rem); color: white; background: radial-gradient(circle at 80% 15%, rgba(217,181,87,.24), transparent 27rem), linear-gradient(135deg, #21102f, #482265 70%, #6b397c); }
  .home-hero::before { position: absolute; inset: 0; opacity: .12; background-image: linear-gradient(30deg, transparent 46%, rgba(255,255,255,.5) 47%, transparent 48%); background-size: 3.5rem 3.5rem; content: ""; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0,1.25fr) minmax(18rem,.75fr); gap: clamp(3rem,8vw,7rem); align-items: center; }
  .hero-copy { max-width: 49rem; }
  h1 { margin-bottom: 1.5rem; color: white; }
  .hero-lead { max-width: 42rem; margin-bottom: 2rem; color: rgba(255,255,255,.78); font-size: clamp(1.1rem,2vw,1.3rem); }
  .service-panel { overflow: hidden; border: 1px solid rgba(255,255,255,.18); border-radius: 1.5rem; box-shadow: 0 30px 80px rgba(18,5,28,.3); background: rgba(255,255,255,.1); backdrop-filter: blur(14px); }
  .service-panel__top { display: flex; padding: 1.5rem; align-items: center; gap: 1rem; }
  .service-panel__top img { width: 4.75rem; height: 4.75rem; border-radius: 50%; background: white; }
  .service-panel__top p { display: grid; margin: 0; }
  .service-panel__top span { color: var(--color-accent-light); font-size: .76rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .service-panel__top strong { font-family: Georgia,serif; font-size: 1.35rem; }
  .service-panel__times { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid rgba(255,255,255,.16); }
  .service-panel__times div { display: grid; padding: 1.25rem 1.5rem; }
  .service-panel__times div + div { border-left: 1px solid rgba(255,255,255,.16); }
  .service-panel__times span { color: rgba(255,255,255,.65); font-size: .8rem; }
  .service-panel > a { display: block; padding: 1.2rem 1.5rem; color: white; font-size: .88rem; text-decoration: none; }
  .quick-links { background: white; }
  .quick-links__grid { display: grid; grid-template-columns: repeat(3,1fr); }
  .quick-links a { position: relative; display: grid; padding: 2rem clamp(1rem,3vw,2.5rem); border-right: 1px solid var(--color-border); text-decoration: none; }
  .quick-links a:first-child { border-left: 1px solid var(--color-border); }
  .quick-links span, .card-number { color: #96712a; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .quick-links strong { font-family: Georgia,serif; font-size: 1.35rem; }
  .quick-links small { color: var(--color-muted); }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem,7vw,6rem); align-items: start; }
  .intro-grid h2 { margin-bottom: 0; }
  .text-link { color: var(--color-primary); font-weight: 800; }
  .section-heading { display: flex; margin-bottom: 2rem; align-items: end; justify-content: space-between; gap: 2rem; }
  .section-heading h2 { max-width: 44rem; margin-bottom: 0; }
  .section-heading > a { flex: 0 0 auto; font-weight: 800; }
  .schedule-grid { display: grid; grid-template-columns: repeat(4,1fr); border-block: 1px solid rgba(255,255,255,.16); }
  .schedule-grid article { padding: 2rem 1.5rem; border-right: 1px solid rgba(255,255,255,.16); }
  .schedule-grid article:last-child { border-right: 0; }
  .schedule-grid span { color: var(--color-accent-light); font-size: .76rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .schedule-grid h3 { margin: .7rem 0 .4rem; }
  .schedule-grid p { margin: 0; color: rgba(255,255,255,.7); }
  .card-number { margin-bottom: 2rem; }
  .ministries-preview .card p:last-child { color: var(--color-muted); }
  @media (max-width: 850px) { .hero-grid { grid-template-columns: 1fr; } .service-panel { max-width: 34rem; } .schedule-grid { grid-template-columns: 1fr 1fr; } .schedule-grid article:nth-child(2) { border-right: 0; } .schedule-grid article:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,.16); } }
  @media (max-width: 700px) { .quick-links__grid, .intro-grid { grid-template-columns: 1fr; } .quick-links a, .quick-links a:first-child { border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); border-left: 1px solid var(--color-border); } .section-heading { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 480px) { .service-panel__times, .schedule-grid { grid-template-columns: 1fr; } .service-panel__times div + div { border-top: 1px solid rgba(255,255,255,.16); border-left: 0; } .schedule-grid article { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.16); } }
</style>
